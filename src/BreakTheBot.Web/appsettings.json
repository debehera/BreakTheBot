{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "Sqlite"
  },
  "ConnectionStrings": {
    "Default": "Data Source=breakthebot.db"
  },
  "Gemini": {
    "Model": "gemini-3.5-flash-lite"
  },
  "Limits": {
    "PerMinutePerUser": 10,
    "PerDayPerUser": 40,
    "PerDayGlobal": 400,
    "MaxMessageChars": 4000,
    "MaxOutputTokens": 1024
  }
}