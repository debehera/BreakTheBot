@page
@model ErrorModel
@{
    ViewData["Title"] = Model.Heading;
}

<div class="text-center py-5">
    <div class="btb-error-code">@Model.Code</div>
    <h2 class="mb-3" style="font-family: var(--btb-mono);">@Model.Heading</h2>
    <p class="text-secondary mx-auto" style="max-width: 520px;">@Model.Message</p>

    <div class="d-flex flex-wrap justify-content-center gap-2 mt-4">
        <a class="btn btn-primary" href="/">Back to home</a>
        <a class="btn btn-outline-light" href="/Dashboard">Dashboard</a>
        <a class="btn btn-outline-light" href="/Leaderboard">Leaderboard</a>
    </div>

    @if (!string.IsNullOrEmpty(Model.RequestId))
    {
        <p class="text-secondary small mt-4">Reference: <code>@Model.RequestId</code></p>
    }
</div>