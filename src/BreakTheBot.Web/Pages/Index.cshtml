@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
    var signedIn = User.Identity?.IsAuthenticated == true;
}

<section class="btb-hero text-center">
    <h1>Break the bot. <span class="btb-accent">Then fix it.</span></h1>
    <p class="lead text-secondary mx-auto" style="max-width: 640px;">
        A hands-on lab for the OWASP Top 10 for LLM Applications. Attack deliberately vulnerable
        AI apps, capture the flag, learn why it worked, then switch on a defense and try again.
    </p>
    <div class="d-flex flex-wrap justify-content-center gap-2 mt-4">
        @if (signedIn)
        {
            <a class="btn btn-primary" href="/Dashboard">Continue playing</a>
        }
        else
        {
            <a class="btn btn-primary" href="/Identity/Account/Register">Get started, it's free</a>
            <a class="btn btn-outline-light" href="/Identity/Account/Login">Log in</a>
        }
        <a class="btn btn-outline-light" href="/Leaderboard">View leaderboard</a>
    </div>
</section>

<section class="mb-5">
    <h5 class="text-center mb-3" style="font-family: var(--btb-mono);">How it works</h5>
    <div class="row row-cols-2 row-cols-lg-4 g-3">
        <div class="col">
            <div class="btb-step">
                <div class="btb-step-num">1</div>
                <strong>Attack</strong>
                <p>Chat with a vulnerable AI app and try to make it misbehave.</p>
            </div>
        </div>
        <div class="col">
            <div class="btb-step">
                <div class="btb-step-num">2</div>
                <strong>Learn</strong>
                <p>Capture the flag, then read why the attack worked and how OWASP says to prevent it.</p>
            </div>
        </div>
        <div class="col">
            <div class="btb-step">
                <div class="btb-step-num">3</div>
                <strong>Defend</strong>
                <p>Switch on the defense for that level, the way a real team would harden it.</p>
            </div>
        </div>
        <div class="col">
            <div class="btb-step">
                <div class="btb-step-num">4</div>
                <strong>Verify</strong>
                <p>Replay your attack against the defense and see whether it holds.</p>
            </div>
        </div>
    </div>
</section>

<h5 class="text-center mb-3" style="font-family: var(--btb-mono);">The OWASP LLM Top 10</h5>
<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-3 mb-5">
    @foreach (var item in Model.Items)
    {
        <div class="col">
            <div class="btb-card @(item.IsPlayable ? "btb-card-playable" : "btb-card-soon")">
                @if (item.IsPlayable)
                {
                    <span class="btb-badge btb-badge-playable">Playable</span>
                }
                else
                {
                    <span class="btb-badge btb-badge-soon">🔒 Coming soon</span>
                }
                <h5><span class="btb-accent">@item.Code</span> @item.Title</h5>
                <p>@item.Blurb</p>
                @if (item.IsPlayable)
                {
                    if (Model.IsOpen(item.LevelNumber!.Value))
                    {
                        <a class="btn btn-primary btn-sm" href="/Levels/Play?id=@item.LevelNumber">Open level @item.LevelNumber</a>
                    }
                    else
                    {
                        <span class="text-secondary small">Level @item.LevelNumber (building soon)</span>
                    }
                }
            </div>
        </div>
    }
</div>