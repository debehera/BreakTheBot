@page
@using BreakTheBot.Web.Data
@using BreakTheBot.Web.Levels
@using BreakTheBot.Web.Services
@using Microsoft.AspNetCore.Antiforgery
@model PlayModel
@inject IAntiforgery Antiforgery
@{
    ViewData["Title"] = $"Level {Model.Level.Id}: {Model.Level.Codename}";
    var token = Antiforgery.GetAndStoreTokens(HttpContext).RequestToken;

    var status = Model.Progress?.Status ?? LevelStatus.NotStarted;
    var captured = status >= LevelStatus.Captured;
    var defended = status == LevelStatus.Defended;
    var hintsUsed = Model.Progress?.HintsUsed ?? 0;
    var hintsLeft = ScoringService.MaxHints - hintsUsed;
    var hintsShown = Model.Level.Hints.Take(hintsUsed).ToList();
}

<div class="pt-4 pb-2">
    <a href="/Dashboard" class="text-secondary small">&larr; Dashboard</a>
    <h2 class="mt-2 mb-1" style="font-family: var(--btb-mono);">
        Level @Model.Level.Id &middot; @Model.Level.Codename
    </h2>
    <span class="btb-badge btb-badge-playable">@Model.Level.OwaspId @Model.Level.Title</span>
    @if (Model.Level.Kind == LevelKind.Lighter) { <span class="btb-badge btb-badge-soon">lighter level</span> }
</div>

<div id="chat-app" class="row g-3 mb-4"
     data-level-id="@Model.Level.Id"
     data-token="@token"
     data-max-chars="@Model.MaxChars"
     data-captured="@(captured ? "true" : "false")"
     data-hints-left="@hintsLeft">

    <div class="col-lg-4">
        <div class="btb-panel mb-3">
            <h6>Scenario</h6>
            <p class="mb-3">@Model.Level.Scenario</p>
            <h6>Objective</h6>
            <p class="mb-0">@Model.Level.Objective</p>
        </div>

        <div class="btb-panel mb-3">
            <h6>Hints</h6>
            <ol id="hint-list" class="ps-3 mb-2">
                @foreach (var h in hintsShown)
                {
                    <li class="mb-1">@h</li>
                }
            </ol>
            @if (!captured)
            {
                <button id="hint-btn" class="btn btn-outline-light btn-sm" @(hintsLeft <= 0 ? "disabled" : "")>
                    @(hintsLeft <= 0 ? "No hints left" : "Show a hint (-10 points)")
                </button>
                <div class="small text-secondary mt-2"><span id="hints-left">@hintsLeft</span> of @ScoringService.MaxHints hints left</div>
            }
            else
            {
                <div class="small text-secondary">Hints are closed once the flag is captured.</div>
            }
        </div>

        <div class="btb-panel">
            <h6>Submit flag</h6>
            @if (captured)
            {
                <div id="flag-done" class="btb-result btb-result-ok">
                    Flag captured! +@(Model.Progress?.AttackPoints ?? 0) points
                </div>
            }
            else
            {
                <div class="input-group">
                    <input id="flag-input" class="form-control" placeholder="FLAG{...}" autocomplete="off"
                           style="font-family: var(--btb-mono);" />
                    <button id="flag-btn" class="btn btn-primary">Go</button>
                </div>
                <div id="flag-msg" class="small mt-2" aria-live="polite"></div>
            }
        </div>
    </div>

    <div class="col-lg-8">
        <div class="btb-panel">
            <div class="d-flex justify-content-between align-items-center">
                <h6 class="mb-0">Chat</h6>
                <button id="reset-btn" class="btn btn-outline-light btn-sm">Reset conversation</button>
            </div>
            <div id="chat-log" class="btb-chat-log mt-2" aria-live="polite">
                @foreach (var h in Model.History)
                {
                    <div class="btb-msg btb-msg-user">@h.UserMessage</div>
                    <div class="btb-msg btb-msg-bot">@h.BotResponse</div>
                }
                @if (!Model.History.Any())
                {
                    <div class="btb-msg btb-msg-note" id="chat-empty">Say hello to start the conversation.</div>
                }
            </div>
            <div class="d-flex gap-2 mt-2">
                <textarea id="chat-input" class="form-control" rows="2" maxlength="@Model.MaxChars"
                          placeholder="Type your message... (Enter to send, Shift+Enter for a new line)"
                          style="font-family: var(--btb-mono);"></textarea>
                <button id="chat-send" class="btn btn-primary">Send</button>
            </div>
            <div class="small text-secondary mt-2">
                Messages left today: <span id="chat-quota">@Model.RemainingToday</span>
            </div>
        </div>
    </div>
</div>

@if (captured)
{
    <div class="btb-panel mb-4" id="explanation-panel">
        <h6>Why it worked (OWASP @Model.Level.OwaspId)</h6>
        @* Explanation text is written by us in the level class, so it is trusted HTML. *@
        <div class="btb-explanation">@Html.Raw(Model.Level.ExplanationHtml)</div>
    </div>

    @if (Model.Level.HasDefense)
    {
        <div class="btb-panel mb-5" id="defense-panel">
            <h6>Defend</h6>
            <p>@Model.Level.DefenseSummary</p>

            @if (defended)
            {
                <div id="defense-done" class="btb-result btb-result-ok mb-3">
                    Defended! +@(Model.Progress?.DefensePoints ?? 0) points. You can still keep attacking with the defense on.
                </div>
            }

            <div class="form-check form-switch mb-3">
                <input class="form-check-input" type="checkbox" role="switch" id="defense-switch" />
                <label class="form-check-label" for="defense-switch">Enable defense (applies to the chat above)</label>
            </div>

            <button id="replay-btn" class="btn btn-primary">Replay my attack</button>
            <div class="small text-secondary mt-2">
                Re-runs the message that captured the flag, with the defense switched on. Uses one AI message.
            </div>
            <div id="replay-result" class="mt-3" aria-live="polite"></div>
        </div>
    }
}

@section Scripts {
    <script src="~/js/chat.js" asp-append-version="true"></script>
}